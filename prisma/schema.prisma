// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  male
  female
  other
}

model Employee {
  id                     String                   @id @default(uuid())
  isActive              Boolean                  @default(true)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @default(now())
  personalDetails       EmployeePersonalDetails?
  contactDetails        EmployeeContactDetails?
  details               EmployeeDetails?
  leaves                EmployeeLeave[]
  attendance            EmployeeAttendance[]
}

model Department {
  id                 String               @id @default(uuid())
  name               String               @db.VarChar(255)
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now())
  departmentPosition DepartmentPosition[]
  employeeDetails    EmployeeDetails[]
}

model Position {
  id                 String               @id @default(uuid())
  name               String               @db.VarChar(255)
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now())
  departmentPosition DepartmentPosition[]
  employeeDetails    EmployeeDetails[]
}

model DepartmentPosition {
  id           String     @id @default(uuid())
  departmentId String
  positionId   String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id])
  position     Position   @relation(fields: [positionId], references: [id])
}

model EmployeePersonalDetails {
  id          String    @id @default(uuid())
  employeeId  String    @unique
  firstName   String    @db.VarChar(255)
  middleName  String?   @db.VarChar(255)
  lastName    String?   @db.VarChar(255)
  gender      Gender
  fatherName  String    @db.VarChar(255)
  motherName  String    @db.VarChar(255)
  bloodGroup  String?   @db.VarChar(5)
  avatar      String
  dateOfBirth DateTime  @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  employee    Employee  @relation(fields: [employeeId], references: [id])
}

model EmployeeContactDetails {
  id          String   @id @default(uuid())
  employeeId  String   @unique
  phoneNumber String   @db.VarChar(255)
  email       String   @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  employee    Employee @relation(fields: [employeeId], references: [id])
}

model EmployeeDetails {
  id           String     @id @default(uuid())
  employeeId   String     @unique
  firstName    String
  lastName     String
  departmentId String
  positionId   String
  salary       Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now())
  employee     Employee   @relation(fields: [employeeId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  position     Position   @relation(fields: [positionId], references: [id])
}

model EmployeeLeave {
  id         String   @id @default(uuid())
  employeeId String
  leaveType  String
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model EmployeeAttendance {
  id         String   @id @default(uuid())
  employeeId String
  date       DateTime @db.Date
  status     String
  employee   Employee @relation(fields: [employeeId], references: [id])
}

